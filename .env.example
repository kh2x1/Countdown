# ----------------------------------------------------------------------------
# Supabase (optional)
# The app works out-of-the-box with bundled seed data. Add these to pull
# fixtures from your own Supabase project instead.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is only needed for the server-side data sync script.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# Football data API (optional) — used by scripts/sync to refresh fixtures.
# Get a free key at https://www.api-football.com/ or https://www.football-data.org/
# ----------------------------------------------------------------------------
FOOTBALL_API_PROVIDER=api-football
FOOTBALL_API_KEY=

# Public site URL (used for SEO metadata / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
